[covariance_sources]
phot = True
inst = white
osc = True
gran = True
rot_act = qp

[hyperparameter_scaling]
osc_hyperparameters=scaled
gran_hyperparameters=scaled
rot_act_hyperparameters=solar
               
[instrument_jitter]
NEID_jitter = 0.3
ESPRESSO_jitter = 0.3
HIRES_jitter = 1.0
HARPS_jitter = 1.0

[parameter_grid]
#values should be specified in the same space as the corresponding scaling
#(i.e., period_low=-1 is equivalent to 0.1 days if period_scale=log)

mass_low=-1.0
mass_high=3.0
mass_step=0.2
mass_scale=log

period_low=-0.3
period_high=3.65
period_step=0.1
period_scale=log

phi_low=0
phi_high=6.28318
phi_step=0.628318

ecc_low=0
ecc_high=0.5
ecc_step=0.25
ecc_scale=linear

omega_low=-3.14159
omega_high=3.14159
omega_step=0.628318

[progression_parameters]
nobs_resolution=5
min_obs=10

[plotting_grid]
plot_contours=True
plot_colormap=True
contour_levels=3,5,10
plot_K_lines=False
plot_known_exoplanets=False
plot_ss_planets=True
ecc_index=0

[plotting_progression]
plot_K=True
plot_period=True
plot_ecc=True